# Salin ke .env.local lalu isi dari Supabase Dashboard > Project Settings > API.
# Hanya SUPABASE_URL dan SUPABASE_PUBLISHABLE_KEY yang dipakai aplikasi (dan masuk ke bundle browser).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Tidak dipakai oleh frontend dan tidak pernah dikirim ke browser. Jangan di-commit.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
